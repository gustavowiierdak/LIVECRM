{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "Atendimento web isolado por sessão",
    "subtitle": "Link público por empresa, entrada autônoma na Inbox e histórico separado do WhatsApp",
    "output": "webchat-isolado.html",
    "quality_profile": "standard"
  },
  "lanes": [
    { "id": "humano", "label": "Pessoas" },
    { "id": "app", "label": "Aplicativo" },
    { "id": "db", "label": "Banco privado" }
  ],
  "mainPath": [
    "config-ui",
    "config-api",
    "config",
    "portal",
    "start",
    "conversation",
    "operator",
    "closure",
    "session",
    "messages"
  ],
  "nodes": [
    {
      "id": "config-ui",
      "lane": "humano",
      "col": 0,
      "type": "ui",
      "label": "Conexões › Atendimento web: ligar e copiar link"
    },
    {
      "id": "config-api",
      "lane": "app",
      "col": 1,
      "type": "api",
      "label": "GET/PATCH settings/webchat; manager, Zod, audit"
