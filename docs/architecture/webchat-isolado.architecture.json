      "label": "Gerente ajusta a configuração após revisar"
    },
    { "id": "e14", "from": "messages", "to": "portal", "label": "Resposta isolada ao visitante" },
    {
      "id": "e16",
      "from": "messages",
      "to": "lgpd-trigger",
      "label": "Redigir na virada do contato"
    },
    {
      "id": "e17",
      "from": "lgpd-trigger",
      "to": "lgpd-export",
      "label": "Direito de acesso antes da redação"
    },
    { "id": "e18", "from": "config", "to": "portal", "label": "Link público da organização" },
    { "id": "e19", "from": "portal", "to": "start", "label": "Nome, setor e mensagem" },
    { "id": "e20", "from": "start", "to": "conversation", "label": "Criação atômica e isolada" },
    {
      "id": "e21",
      "from": "conversation",
      "to": "operator",
      "label": "Conversa web aparece na Fila"
    },
    { "id": "e22", "from": "operator", "to": "closure", "label": "Fechar atendimento" },
    {
      "id": "e23",
      "from": "closure",
      "to": "messages",
      "label": "Grava aviso no mesmo fechamento"
    },
    { "id": "e24", "from": "closure", "to": "session", "label": "Leitura passa a active=false" },
    {
      "id": "e25",
      "from": "session",
