    { "id": "e20", "from": "start", "to": "conversation", "label": "Criação atômica e isolada" },
    {
      "id": "e21",
      "from": "conversation",
      "to": "operator",
      "label": "Conversa web aparece na Fila"
    },
    { "id": "e22", "from": "operator", "to": "closure", "label": "Fechar atendimento" },
    {
      "id": "e23",
      "from": "closure",
      "to": "messages",
