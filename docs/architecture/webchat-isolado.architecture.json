    { "id": "e27", "from": "canonical", "to": "agent", "label": "Despacha mensagem nova" },
    { "id": "e28", "from": "agent", "to": "agent-send", "label": "Resposta e ferramentas" },
    { "id": "e29", "from": "agent-send", "to": "messages", "label": "Entrega na sessão web" },
    { "id": "e30", "from": "operator", "to": "reset", "label": "Administrador confirma reset" },
