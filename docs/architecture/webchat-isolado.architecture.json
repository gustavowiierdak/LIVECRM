{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "Atendimento web isolado por sessão",
    "subtitle": "Link público por empresa, transporte web isolado e histórico canônico compartilhado com os agentes",
    "output": "webchat-isolado.html",
    "quality_profile": "standard"
  },
  "lanes": [
    { "id": "humano", "label": "Pessoas" },
    { "id": "app", "label": "Aplicativo" },
    { "id": "db", "label": "Banco privado" }
  ],
  "mainPath": [
    "config-ui",
    "config-api",
    "config",
    "portal",
    "start",
    "conversation",
    "operator",
    "closure",
    "session",
    "messages"
  ],
  "nodes": [
    {
      "id": "config-ui",
      "lane": "humano",
      "col": 0,
      "type": "ui",
      "label": "Conexões › Atendimento web: ligar e copiar link"
    },
    {
      "id": "config-api",
      "lane": "app",
      "col": 1,
      "type": "api",
      "label": "GET/PATCH settings/webchat; manager, Zod, audit"
    },
    {
      "id": "config",
      "lane": "db",
      "col": 2,
      "type": "database",
      "label": "webchat_channel_configs; desligado por padrão"
    },
    {
      "id": "operator",
      "lane": "humano",
      "col": 3,
      "type": "ui",
      "label": "Inbox: conversa própria, resposta e menu Responder citando com prévia cancelável"
    },
    {
      "id": "handoff",
      "lane": "db",
      "col": 4,
      "type": "database",
      "label": "Handoff com digest; consumo atômico e único"
    },
    {
      "id": "portal",
      "lane": "humano",
      "col": 5,
      "type": "ui",
      "label": "/atendimento/[publicId]: nome, setor e primeira mensagem"
    },
    {
      "id": "start",
      "lane": "app",
      "col": 6,
      "type": "api",
      "label": "POST webchat/start: Origin, Zod, limite e sessão segura"
    },
    {
      "id": "conversation",
      "lane": "db",
      "col": 7,
      "type": "database",
      "label": "RPC atômica: contato + conversa web + primeira mensagem"
    },
    {
      "id": "session",
      "lane": "app",
      "col": 6,
      "type": "api",
      "label": "Cookie opaco, CSRF, Origin e sessão retomável"
    },
    {
      "id": "messages",
      "lane": "db",
      "col": 7,
      "type": "database",
      "label": "webchat_messages por sessão; autor humano/IA e citação resolvida na mesma sessão, gravada atomicamente em metadata.webchat_reply"
    },
    {
      "id": "media",
      "lane": "app",
      "col": 6,
      "type": "api",
      "label": "Imagem e áudio: sessão + CSRF + Origin, upload privado e acesso por mensagem"
    },
    {
      "id": "reply-notice",
      "lane": "app",
      "col": 6,
      "type": "process",
      "label": "Resposta nova por polling: aviso dentro do chat enquanto aberto"
    },
    {
      "id": "push-subscription",
      "lane": "db",
      "col": 7,
      "type": "database",
      "label": "Inscrição Web Push isolada por organização e sessão do visitante"
    },
    {
      "id": "push-worker",
      "lane": "app",
      "col": 8,
      "type": "process",
      "label": "Evento durável da resposta entrega aviso genérico ao celular, sem conteúdo privado"
    },
    {
      "id": "canonical",
      "lane": "db",
      "col": 8,
      "type": "database",
      "label": "messages com mesmo ID para demanda, IA e recibo financeiro"
    },
    {
      "id": "agent",
      "lane": "app",
      "col": 9,
      "type": "process",
      "label": "Agente publicado ou roteador da sessão web"
    },
    {
      "id": "agent-send",
      "lane": "app",
      "col": 10,
      "type": "api",
      "label": "Envio da IA com idempotência e veto à posse humana"
    },
    {
      "id": "closure",
      "lane": "db",
      "col": 8,
      "type": "database",
      "label": "Fechamento atômico: sessão inativa + aviso de sistema"
    },
    {
      "id": "audit",
      "lane": "db",
      "col": 3,
      "type": "database",
      "label": "api_audit_log: configuração, emissão e resposta"
    },
    {
      "id": "audit-ui",
      "lane": "humano",
      "col": 4,
      "type": "ui",
      "label": "/app/audit: revisão das ações do webchat"
    },
    {
      "id": "lgpd-trigger",
      "lane": "db",
      "col": 8,
      "type": "database",
      "label": "Anonimização revoga acesso e redige mensagens web"
    },
    {
      "id": "lgpd-export",
      "lane": "app",
      "col": 9,
      "type": "api",
      "label": "Export LGPD inclui webchat sem digests de sessão"
    },
    {
      "id": "reset",
      "lane": "app",
      "col": 9,
      "type": "api",
      "label": "Zona de perigo: apaga mensagens, sessões e handoffs web antes da conversa; audita falha parcial"
    }
  ],
  "edges": [
