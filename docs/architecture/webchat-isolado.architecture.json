    { "id": "e3", "from": "config", "to": "operator", "label": "Opt-in libera emissão" },
    { "id": "e4", "from": "operator", "to": "handoff", "label": "Código com setor" },
    {
      "id": "e5",
      "from": "handoff",
      "to": "portal",
      "label": "Código entregue pelo canal autorizado"
    },
    { "id": "e6", "from": "portal", "to": "session", "label": "Consumo sem URL" },
    { "id": "e7", "from": "session", "to": "handoff", "label": "Marca consumo e cria sessão" },
    { "id": "e8", "from": "session", "to": "messages", "label": "Leitura/escrita só da sessão" },
    { "id": "e9", "from": "messages", "to": "operator", "label": "Respostas na Inbox" },
    { "id": "e10", "from": "operator", "to": "messages", "label": "Resposta simples/citada: RLS, escopo, idempotência e gravação atômica" },
    { "id": "e11", "from": "config-api", "to": "audit", "label": "Mudança auditada" },
    { "id": "e12", "from": "operator", "to": "audit", "label": "Emissão e resposta auditadas" },
    {
      "id": "e13",
      "from": "audit",
