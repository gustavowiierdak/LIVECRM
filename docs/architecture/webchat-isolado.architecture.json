    {
      "id": "e16",
      "from": "messages",
      "to": "lgpd-trigger",
      "label": "Redigir na virada do contato"
    },
    {
      "id": "e17",
      "from": "lgpd-trigger",
      "to": "lgpd-export",
      "label": "Direito de acesso antes da redação"
    },
    { "id": "e18", "from": "config", "to": "portal", "label": "Link público da organização" },
